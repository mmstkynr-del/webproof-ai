{
  "name": "webproof-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MAIN_AGENT",
        "class_name": "MainAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MainAgent"
      ]
    }
  ]
}
